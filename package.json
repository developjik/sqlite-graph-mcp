{
  "name": "@developjik/sqlite-graph-mcp",
  "version": "0.5.0",
  "mcpName": "io.github.developjik/sqlite-graph-mcp",
  "description": "Zero-embedding code & spec graph MCP server: indexes a workspace into SQLite and answers 5-operator graph queries (find, walk, filter, minus, answer) over recursive CTEs.",
  "author": "Inkwon Jung (https://github.com/developjik)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developjik/sqlite-graph-mcp.git"
  },
  "homepage": "https://github.com/developjik/sqlite-graph-mcp#readme",
  "bugs": {
    "url": "https://github.com/developjik/sqlite-graph-mcp/issues"
  },
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "sqlite-graph-mcp": "dist/bin/cli.js",
    "sqlite-graph": "dist/bin/cli.js"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.ko.md",
    "vendor",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "vendor:wasm": "cp node_modules/tree-sitter-wasms/out/tree-sitter-typescript.wasm node_modules/tree-sitter-wasms/out/tree-sitter-tsx.wasm vendor/",
    "test:watch": "vitest",
    "start": "node dist/bin/cli.js serve",
    "check:versions": "node scripts/check-version-sync.mjs",
    "prepublishOnly": "npm run check:versions && npm run typecheck && npm run build && npm test",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "sqlite",
    "code-graph",
    "knowledge-graph",
    "recursive-cte",
    "model-context-protocol",
    "code-search",
    "llm"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^12.11.1",
    "web-tree-sitter": "0.25.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "tree-sitter-wasms": "^0.1.13",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
